{
  "name": "raptorxilef/kuno-bella-digital",
  "description": "Digitale Kuno Beller Entwicklungstabelle",
  "type": "project",
  "license": "Copyright (c) 2026 Felix Maywald alias RaptorXilef. All rights reserved.",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "symfony/http-foundation": "^7.0",
    "symfony/routing": "^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.35.6",
    "phpmd/phpmd": "^3.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.4",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/Backend/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "process-timeout": 0,
    "platform": {
      "php": "8.3.0"
    },
    "vendor-dir": "vendor/",
    "optimize-autoloader": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "scripts": {
    "chk:stan": "phpstan analyse src/Backend --level max",
    "chk:cs": "phpcs",
    "test": "phpunit",
    "fix:modern": "rector process",
    "fix:style": "php-cs-fixer fix --allow-risky=yes",
    "qa": [
      "@chk:stan",
      "@test"
    ]
  }
}
