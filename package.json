{
  "name": "@raptorxilef/kuno-bella-digital",
  "version": "0.2.1",
  "description": "Digitale, datenschutzkonforme Kuno Beller Entwicklungstabelle nach DDD/VSA",
  "type": "module",
  "author": "Felix Maywald <RaptorXilef>",
  "license": "Copyright (c) 2026 Felix Maywald alias RaptorXilef. All rights reserved.",
  "engines": {
    "node": ">=26.4.0",
    "npm": ">=11.11.0"
  },
  "allowScripts": {
    "sharp": true,
    "chromedriver": true,
    "@parcel/watcher": true,
    "core-js": true
  },
  "scripts": {
    "// --- PHASE 1: DEVELOPMENT (VITE) ---": "",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "// --- PHASE 2: TESTING ---": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "// --- PHASE 3: QUALITY & LINTING ---": "",
    "chk:biome": "biome check .",
    "chk:css": "stylelint \"src/assets/scss/**/*.scss\"",
    "chk:html": "markuplint \"**/*.html\"",
    "chk:spell": "cspell lint \"**\" --no-progress",
    "// --- PHASE 4: FIXING ---": "",
    "fix:biome": "biome check --write .",
    "fix:css": "stylelint \"src/assets/scss/**/*.scss\" --fix",
    "// --- MASTER COMMANDS ---": "",
    "chk": "npm run chk:biome && npm run chk:css && npm run chk:html && npm run test",
    "fix": "npm run fix:biome && npm run fix:css",
    "// --- PHASE 5: RELEASE & CI ---": "",
    "release": "release-it"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@cspell/dict-de-de": "^4.1.2",
    "@markuplint/html-spec": "5.5.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@vitest/ui": "^4.1.5",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "cspell": "^10.0.0",
    "markuplint": "5.5.0",
    "release-it": "^21.0.1",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.9.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-order": "^8.1.1",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "deepmerge": ">=4.3.1",
    "basic-ftp": ">=6.2.2",
    "glob": ">=14.0.2",
    "minimatch": ">=11.0.1"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "lint-staged": {
    "*.php": [
      "vendor/bin/phpstan analyze",
      "vendor/bin/rector process --dry-run",
      "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run"
    ],
    "*.json": "biome check --write --no-errors-on-unmatched",
    "*.js": [
      "biome check --write --no-errors-on-unmatched",
      "vitest related --run"
    ],
    "*.scss": "stylelint --fix"
  }
}
